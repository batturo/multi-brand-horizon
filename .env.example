# Copy to .env.local for local development, and add the same names in
# Vercel > Project > Settings > Environment Variables.
# Never commit real values.

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (starts sb_publishable_). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (starts sb_secret_). The legacy "service_role" key also works.
# Only used by local scripts (sample products). Do NOT add it to Vercel.
SUPABASE_SECRET_KEY=

# Public site address with https and no trailing slash. Used for canonical
# URLs, sitemap and link previews. Overrides store.siteUrl when set.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local preview only: show the 12 sample products from code when Supabase is
# not configured, so pages can be reviewed without a database. Ignored when
# Supabase is configured, and refused on Netlify, Vercel or CI (no admin login).
# DEMO_CATALOG=samples

# Set to true on a preview copy of the shop so search engines do not index
# it (robots.txt blocks everything and every page gets noindex).
# SITE_NOINDEX=true
